#!/usr/bin/env bash
# Pre-change gate: nudges agent to create beads task before file edits.
# Registered as PreToolUse hook for Edit and Write in hooks.json.
# Always exits 0 — warns but never blocks.

set -euo pipefail

# --- Guards ---

# Only run if beads is initialized (project-local or global)
GIT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
BEADS_DIR="${GIT_ROOT:+$GIT_ROOT/.beads}"

if [ -z "$BEADS_DIR" ] || { [ ! -d "$BEADS_DIR" ] && [ ! -d "$HOME/.beads" ]; }; then
    exit 0
fi

# Check bd availability
if ! command -v bd >/dev/null 2>&1; then
    exit 0
fi

# --- Cache ---
# C1: Per-project cache avoids cross-project collisions in parallel sessions
# F4: Guard against negative cache age from clock skew

# M2: Use XDG_RUNTIME_DIR (per-user, not world-writable) with /tmp fallback.
#     Check for symlinks before read/write to prevent CWE-59 attacks.
BEADS_PATH="${BEADS_DIR:-$HOME/.beads}"
PROJECT_HASH=$(printf '%s' "$BEADS_PATH" | md5sum 2>/dev/null | cut -c1-8 || printf '%s' "$BEADS_PATH" | md5 2>/dev/null | cut -c1-8 || echo "default")
CACHE_DIR="${XDG_RUNTIME_DIR:-/tmp}"
CACHE="${CACHE_DIR}/.beads-gate-${USER:-$(id -un)}-${PROJECT_HASH}"

# Symlink guard: remove and skip if symlink (prevents symlink attacks on shared systems)
if [ -L "$CACHE" ]; then
    rm -f "$CACHE"
elif [ -f "$CACHE" ]; then
    CACHE_MOD=$(stat -c %Y "$CACHE" 2>/dev/null || stat -f %m "$CACHE" 2>/dev/null || echo 0)
    NOW=$(date +%s)
    CACHE_AGE=$(( NOW - CACHE_MOD ))
    if [ "$CACHE_AGE" -ge 0 ] && [ "$CACHE_AGE" -lt 60 ]; then
        cat "$CACHE"
        exit 0
    fi
fi

# --- Check ---

# B2: Use --json for robust parsing, with text fallback
OUTPUT=""
LISTING_JSON=$(bd list --status=in_progress --json 2>/dev/null || echo "")
if [ -n "$LISTING_JSON" ] && [ "$LISTING_JSON" != "[]" ] && [ "$LISTING_JSON" != "null" ]; then
    # Extract first task ID from JSON array
    TASK_ID=$(printf '%s' "$LISTING_JSON" | grep -o '"id": *"[^"]*"' | head -1 | cut -d'"' -f4 2>/dev/null || echo "")
fi
# Fallback to text parsing if JSON extraction failed
if [ -z "${TASK_ID:-}" ]; then
    LISTING=$(bd list --status=in_progress 2>/dev/null || echo "")
    TASK_ID=$(echo "$LISTING" | grep -v 'No issues' | awk 'NR>1 && NF>0{print $1; exit}' || true)
fi

if [ -z "$TASK_ID" ]; then
    OUTPUT=$(printf '%s\n%s' \
        "WARNING: No active beads task. Create one before modifying files:" \
        "   bd create --title=\"...\" --type=task")
else
    NOTES=$(bd show "$TASK_ID" 2>/dev/null || echo "")
    if ! echo "$NOTES" | grep -q 'tier:'; then
        OUTPUT="WARNING: Active task ($TASK_ID) has no tier assessment. Run /claude-workstation:start to assess."
    fi
fi

# --- Cache and output ---

# Symlink guard on write
[ -L "$CACHE" ] && rm -f "$CACHE"
printf '%s' "$OUTPUT" > "$CACHE"

if [ -n "$OUTPUT" ]; then
    echo "$OUTPUT"
fi

exit 0
