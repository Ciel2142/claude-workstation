#!/usr/bin/env bash
# Append a line to beads task notes without losing existing content.
# Usage: bd-notes-append <task-id> "key: value"
# Reads current notes from bd show, appends new line, writes back.
# Exits 1 if bd not found, task ID missing, or bd show/update fails.

set -euo pipefail

TASK_ID="${1:-}"
NEW_LINE="${2:-}"

if [ -z "$TASK_ID" ] || [ -z "$NEW_LINE" ]; then
    echo "Usage: bd-notes-append <task-id> \"key: value\"" >&2
    exit 1
fi

if ! command -v bd >/dev/null 2>&1; then
    echo "error: bd not found in PATH" >&2
    exit 1
fi

# Fetch task details — fail loudly if bd show errors
BD_SHOW_OUTPUT=$(bd show "$TASK_ID" 2>&1) || {
    echo "error: bd show $TASK_ID failed: $BD_SHOW_OUTPUT" >&2
    exit 1
}

# Extract current notes from bd show output.
# Notes section starts after "NOTES" line and runs until the next
# all-caps section header (PARENT, BLOCKS, CHILDREN, DEPENDENCIES, etc.)
# or end of output if NOTES is the last section.
# F7: Extract notes between NOTES header and next bd-show section header.
# Uses explicit headers to avoid truncating all-caps freetext in notes.
# If beads adds new section headers, add them here to prevent leakage.
CURRENT_NOTES=$(printf '%s\n' "$BD_SHOW_OUTPUT" \
    | sed -n '/^NOTES$/,$ p' \
    | sed '1d' \
    | sed '/^\(TITLE\|STATUS\|PRIORITY\|TYPE\|PARENT\|CHILDREN\|BLOCKS\|BLOCKED BY\|DEPENDS ON\|DEPENDENCIES\|LABELS\|ASSIGNEE\|CREATED\|UPDATED\|ACCEPTANCE CRITERIA\|DESIGN\|COMMENTS\|HISTORY\|ATTACHMENTS\|METADATA\|DESCRIPTION\|DUE\|DEFER\)$/,$d')

if [ -z "$CURRENT_NOTES" ]; then
    bd update "$TASK_ID" --notes "$NEW_LINE"
else
    bd update "$TASK_ID" --notes "${CURRENT_NOTES}
${NEW_LINE}"
fi

# --- Cache write-through ---
# After successful bd update, write to local milestone cache + reset edit counter
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$SCRIPT_DIR/cache-utils.sh" ]; then
    # shellcheck source=cache-utils.sh
    . "$SCRIPT_DIR/cache-utils.sh"
    ensure_cache_dir
    echo "$NEW_LINE" >> "${GATE_CACHE_DIR}/milestones-${TASK_ID}"
    echo 0 > "${GATE_CACHE_DIR}/edit-counter"
fi
